# Nur Beispiele. Echte Zugangsdaten ausschließlich in der Deployment-Umgebung setzen.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL=office@webdesign-alcor.at
NOTIFY_EMAIL=office@webdesign-alcor.at
NEXT_PUBLIC_SITE_URL=https://webdesign-alcor.at

# Admin: für Production UND die gewünschte Preview-Umgebung konfigurieren.
# Passwort exakt übernehmen; keine zusätzlichen Anführungszeichen.
ADMIN_PASSWORD=
# Mindestens 32 zufällige Zeichen; kein Mailbox-Passwort verwenden.
ADMIN_SESSION_SECRET=
